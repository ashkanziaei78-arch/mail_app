{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "functions": {
    "src/app/api/auth/login/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/campaigns/[id]/actions/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/contacts/import/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/send/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/send",
      "schedule": "7 6 * * *"
    }
  ]
}
