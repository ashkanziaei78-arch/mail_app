# ---- پایگاه داده ----
DATABASE_URL="postgresql://mailing:mailing@localhost:5432/mailing?schema=public"

# ---- امنیت ----
# کلید اصلی: امضای کوکی نشست + رمزنگاری کلید API درگاه پیامک.
# با دستور زیر بسازید:  openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---- آدرس عمومی سامانه (داخل پیامک به‌صورت لینک کوتاه فرستاده می‌شود) ----
APP_URL="http://localhost:3000"

# ---- تصویر پس‌زمینه صفحه ورود (اختیاری) ----
NEXT_PUBLIC_HERO_IMAGE="/hero.png"

# ---- وبهوک وضعیت تحویل پیامک (اختیاری) ----
# این توکن را در پنل درگاه پیامک به‌عنوان هدر x-webhook-token یا پارامتر ?token= تنظیم کنید.
# با `openssl rand -hex 32` بسازید.
SMS_WEBHOOK_SECRET=""
